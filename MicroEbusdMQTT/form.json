{
    "elements": [
        {
            "type": "Label",
            "caption": "eBUS adapter with micro-ebusd via MQTT. One instance per eBUS device (circuit). Empty device = status values of the adapter."
        },
        {
            "type": "ValidationTextBox",
            "name": "BaseTopic",
            "caption": "MQTT base topic (as entered in the adapter)"
        },
        {
            "type": "ValidationTextBox",
            "name": "Circuit",
            "caption": "Device (circuit), e.g. hmu, ctlv3, vr_71, vwzio, broadcast"
        },
        {
            "type": "CheckBox",
            "name": "AutoCreate",
            "caption": "Create variables for all received messages automatically"
        },
        {
            "type": "CheckBox",
            "name": "Translate",
            "caption": "Use German names and status texts (Vaillant catalog); units are always set"
        },
        {
            "type": "List",
            "name": "PollMessages",
            "caption": "Messages that are queried actively",
            "rowCount": 8,
            "add": true,
            "delete": true,
            "columns": [
                {
                    "caption": "Message name (e.g. RunDataFlowTemp)",
                    "name": "Name",
                    "width": "auto",
                    "add": "",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                }
            ]
        },
        {
            "type": "NumberSpinner",
            "name": "PollInterval",
            "caption": "Query interval (0 = off)",
            "suffix": "s",
            "minimum": 0
        },
        {
            "type": "CheckBox",
            "name": "WriteEnabled",
            "caption": "Allow writing (send values to the heating system)"
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Request message list from adapter",
            "onClick": "MEBUS_RequestList($id);"
        },
        {
            "type": "Button",
            "caption": "Query now",
            "onClick": "MEBUS_PollNow($id);"
        },
        {
            "type": "Button",
            "caption": "Query all known messages once",
            "onClick": "MEBUS_QueryKnown($id);"
        },
        {
            "type": "Button",
            "caption": "Set up existing variables again (names, units, status texts)",
            "onClick": "MEBUS_ApplyTranslations($id);"
        }
    ],
    "status": [
        { "code": 102, "icon": "active", "caption": "Active" },
        { "code": 104, "icon": "inactive", "caption": "Inactive" },
        { "code": 201, "icon": "error", "caption": "No base topic given" }
    ]
}
